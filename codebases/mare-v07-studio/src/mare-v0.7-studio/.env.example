# Local development. Do not commit .env or use these defaults for public deployment.
MARE_ENVIRONMENT=development
MARE_DATABASE_URL=sqlite+aiosqlite:///./mare-web.db
MARE_AUTH_TOKEN=
MARE_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
MARE_ALLOWED_HOSTS=["localhost","127.0.0.1","api"]
MARE_RATE_LIMIT_PER_MINUTE=120
MARE_MAX_BODY_BYTES=2000000
MARE_LEASE_SECONDS=30
MARE_ROUND_TIMEOUT_SECONDS=600
MARE_MAX_ATTEMPTS=3
MARE_POLL_SECONDS=1
MARE_OPENAI_ENABLED=false
MARE_OPENAI_MODEL=
OPENAI_API_KEY=
# Docker Compose only; use a long URL-safe value in production.
POSTGRES_PASSWORD=mare-local-only
MARE_WEB_PORT=8080

# Experimental planner: optional recording, no allocation change by default.
MARE_PLANNER_CAPTURE=false
MARE_PLANNER_MODE=shadow
MARE_PLANNER_CHECKPOINT=
