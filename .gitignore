# virtualenvs
.venv/
venv/
env/

# python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# trained weights: regenerate these, never commit them
checkpoints/*.pt
checkpoints/*.pth

# run records and workspace layout are local, not source
runs/*.json
studies/*.json
prefs.json
.seeded

# An account that adopts the legacy layout keeps its workspace in the project
# folder itself, so everything it writes lands beside the source. None of it
# is source: scout errands, workbench problems, physics runs, and unpacked
# archives of other people's code.
scouts/
problems/
physics/
codebases/
agentlab/

# datasets pulled or uploaded at runtime
data/
uploads/*
!uploads/demo_corpus.txt
!uploads/demo_corpus.txt.vocab.json

# designs are yours; the worked example ships
saved/*.json
!saved/MiniGPT.json

# imported models
*.onnx

# os
.DS_Store
Thumbs.db
